# Paste these blocks into GEOGRID.TBL *above* the existing priority-1
# HGT_M block (which stays as the global GMTED 30s fallback), then set
#   geog_data_res = 'cop30+...'
# WARNING: without these entries geogrid does NOT error -- it silently
# falls back to 900 m GMTED terrain.

# ---------------------------------------------------------------------
# Copernicus GLO-30 1-arcsec topography, added as resolution 'cop30'.
# Select with geog_data_res = 'cop30+...' on the fine domains.
# Split into 15 pieces because WPS tile filenames carry 5-digit cell
# indices, so no dataset may exceed 99999 cells per side; North America
# at 1 arcsec is 327600 x 216000.  Higher priority is applied first, so
# priority 1 below stays the global GMTED 30s fallback for ocean gaps
# and anywhere outside North America.
# ---------------------------------------------------------------------
===============================
name = HGT_M
        priority = 2
        optional = yes
        dest_type = continuous
        smooth_option = smth-desmth_special; smooth_passes=1
        fill_missing=0.
        interp_option = cop30:average_gcell(4.0)+four_pt+average_4pt
        rel_path = cop30:topo_cop30_1s_r0c0/
