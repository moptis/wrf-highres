# Site configuration. Copy to site.env and edit for the machine you are on.
# Every path below is machine-specific; nothing else in the repo hardcodes one.
# Shell scripts `source` this file; Python reads it via wrfhr.config.

# --- where the case lives (inputs, run dirs, outputs) -----------------------
CASE_ROOT=/scratch/USER/wsw_high

# --- model builds -----------------------------------------------------------
WRF_RUN_DIR=/home/USER/WRF/run                 # wrf.exe, real.exe + data tables
WPS_DIR=/scratch/USER/wsw_high/wps             # geogrid.exe, metgrid.exe, TBLs
WPS_GEOG=/projects/PROJECT/WPS_GEOG            # geographical input data

# --- forcing ----------------------------------------------------------------
MET_DIR=/scratch/USER/met_data                 # ERA5 WPS intermediate files
ERA5_TIMESERIES=/scratch/USER/wsw_high/era5.csv  # hourly 100 m wind at the site

# --- python + post-processing ----------------------------------------------
PYTHON=/home/USER/miniconda3/envs/default/bin/python
WAKEMAP_REPO=/home/USER/wakemap_processing     # provides create-wrg (patched)

# --- scheduler --------------------------------------------------------------
SLURM_ACCOUNT=myaccount
SLURM_QOS=normal
PART_CPU=standard        # full-node exclusive WRF jobs
PART_SHARED=shared       # short single-task jobs (metgrid, real, analysis)
PART_DEBUG=debug         # quick turnaround

# --- run settings -----------------------------------------------------------
WRF_RANKS=64             # capped by WRF's 10-cells-per-patch rule; see docs
WRF_WALLTIME=40:00:00

# --- optional: AceCast GPU build (benchmarked ~10x worse on allocation; see docs)
ACECAST_RUN_DIR=/scratch/USER/acecast/run
ACECAST_ENV=/scratch/USER/nvhpc/acecast_env.sh
