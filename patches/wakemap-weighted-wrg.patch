+def weighted_weibull_fit(x, weights=None):
+    """MLE fit of a two-parameter Weibull (location fixed at 0), optionally weighted.
+
+    With weights=None this defers to scipy so the unweighted path stays
+    bit-identical to the previous behaviour.
+
+    The weighted MLE solves, for shape k,
+        sum(w x^k ln x) / sum(w x^k)  -  1/k  -  sum(w ln x)/sum(w)  =  0
+    then scale A = ( sum(w x^k) / sum(w) )^(1/k).
+
+    Parameters
+    ----------
+    x : array-like
+        Wind speeds.
+    weights : array-like, optional
+        Per-sample weights, aligned with x.  Need not sum to 1.
+
+    Returns
+    -------
+    (k, A) : tuple of float
+    """
+    x = np.asarray(x, dtype=float)
+    if weights is None:
+        k, _, a = weibull_min.fit(x, floc=0)
+        return k, a
+
+    w = np.asarray(weights, dtype=float)
+    m = np.isfinite(x) & (x > 0) & np.isfinite(w) & (w > 0)
+    x, w = x[m], w[m]
+    if x.size < 2 or np.allclose(x, x[0]):
+        return np.nan, np.nan
+
+    W = w.sum()
+    lx = np.log(x)
+    mean_lx = (w * lx).sum() / W
+
+    def root(k):
+        xk = x ** k
+        return (w * xk * lx).sum() / (w * xk).sum() - 1.0 / k - mean_lx
+
+    try:
+        k = brentq(root, 0.1, 50.0, xtol=1e-10)
+    except ValueError:
+        # no sign change in the bracket -- fall back to the unweighted fit
+        kf, _, af = weibull_min.fit(x, floc=0)
+        return kf, af
+
+    a = ((w * x ** k).sum() / W) ** (1.0 / k)
+    return k, a
+
